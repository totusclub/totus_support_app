# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Как в totus_APP: Firebase 12.x, статические фреймворки для RNFB.
$FirebaseSDKVersion = '12.10.0'
$RNFirebaseAsStaticFramework = true

# Старая архитектура (bridge): react-native-callkeep / voip-push-notification / incall-manager
# работают через bridge; как в totus_APP (New Architecture на RN 0.79 падает на iOS 26).
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'TotusSupport' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )

    # Xcode 27 rejects IPHONEOS_DEPLOYMENT_TARGET below 15.0 (privacy bundles
    # from Firebase / RNSVG / AsyncStorage still declare 9.0–12.4).
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target.nil? || deployment_target.to_f < 15.1
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
    end

    # fmt 11.0.2 enables consteval on Apple Clang >= 14. Xcode 16.3+ (including
    # Xcode 27) rejects those format-string checks in format.cc.
    fmt_base = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      contents = File.read(fmt_base)
      needle = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14."
      replacement = "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang (Xcode 16.3+)."
      if contents.include?(needle)
        File.chmod(0o644, fmt_base)
        File.write(fmt_base, contents.sub(needle, replacement))
      end
    end

    # Статический umbrella Pods_*.framework линкуется как -lPods-* и ломает сборку —
    # отдельные поды уже подключены через OTHER_LDFLAGS (как в totus_APP).
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.native_targets.each do |native_target|
        native_target.frameworks_build_phase.files.to_a.each do |build_file|
          name = build_file.display_name
          next unless name&.end_with?('.framework') && name.start_with?('Pods_')
          native_target.frameworks_build_phase.remove_file_reference(build_file.file_ref)
        end
      end
      aggregate_target.user_project.save
    end
  end
end
